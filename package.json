{
  "name": "trustly-client",
  "version": "3.3.0",
  "description": "Trustly client for node.js integrations.",
  "main": "build/main/index.js",
  "typings": "build/main/index.d.ts",
  "module": "build/module/index.js",
  "repository": "https://github.com/danibram/trustly-client",
  "author": {
    "name": "Daniel Biedma Ramos",
    "email": "info@dbr.io",
    "url": "https://dbr.io"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danibram/trustly-client/issues"
  },
  "homepage": "https://github.com/danibram/trustly-client",
  "engines": {
    "node": ">=14.17"
  },
  "files": [
    "build/main",
    "build/module",
    "build/keys"
  ],
  "scripts": {
    "clean": "rimraf build/main build/module",
    "build": "npm run clean && npm run build:main && npm run build:module",
    "build:main": "tsc -p tsconfig.json",
    "build:module": "tsc -p config/exports/tsconfig.module.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build && vitest run tests/unit"
  },
  "keywords": [
    "trustly",
    "client"
  ],
  "devDependencies": {
    "@types/node": "^18.19.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "axios": "^0.33.0",
    "tslib": "^2.8.0"
  }
}
